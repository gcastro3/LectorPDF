{
  "name": "Lector de documentos",
  "short_name": "Lector",
  "description": "Lee tus PDF cómodamente en el celular: texto adaptable, modos de color, letra ajustable, índice y búsqueda.",
  "lang": "es",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#fbfaf7",
  "theme_color": "#2f6f5e",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["application/pdf", ".pdf", "text/plain", ".txt", "text/markdown", ".md"] }
      ]
    }
  }
}
